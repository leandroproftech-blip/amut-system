# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=amut_sistema

# JWT (gere uma string aleatória longa e segura para produção)
JWT_SECRET=troque_esta_chave_por_uma_bem_secreta_e_longa
JWT_EXPIRES_IN=8h

# URL do frontend (para CORS). Com o Express servindo a pasta public/, use a mesma porta.
FRONTEND_URL=http://localhost:3000
